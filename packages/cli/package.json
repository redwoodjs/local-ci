{
  "name": "run-local-ci",
  "version": "0.18.0",
  "description": "Run GitHub Actions locally — pause on failure, retry in place, and keep caches on your machine.",
  "keywords": [
    "act-alternative",
    "ai-agent",
    "ci",
    "coding-agent",
    "devtools",
    "github-actions",
    "local-ci",
    "local-runner",
    "pause-on-failure",
    "runner",
    "workflow"
  ],
  "license": "FSL-1.1-MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/redwoodjs/local-ci.git",
    "directory": "packages/cli"
  },
  "bin": {
    "local-ci": "./dist/native-launcher.js"
  },
  "files": [
    "dist",
    "shim.sh",
    "SKILL.md"
  ],
  "type": "module",
  "exports": {
    "./native-launcher": "./dist/native-launcher.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo && node -e \"const fs=require('node:fs'); for (const file of ['dist/native-launcher.js','dist/cli.js']) if (fs.existsSync(file)) fs.chmodSync(file, 0o755)\"",
    "typecheck": "tsgo",
    "local-ci": "node src/cli.ts",
    "test": "vitest run",
    "agent-ci": "node src/cli.ts"
  },
  "dependencies": {
    "@actions/workflow-parser": "0.3.43",
    "dockerode": "^5.0.1",
    "dtu-github-actions": "workspace:*",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.10.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
