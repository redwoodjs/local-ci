    "digital-twin",
    "github-actions",
    "mock",
    "simulation",
    "testing"
  ],
  "license": "FSL-1.1-MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/redwoodjs/local-ci.git",
    "directory": "packages/dtu-github-actions"
  },
  "files": [
