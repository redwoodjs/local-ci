  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/node": "^22.10.2",
    "@types/polka": "^0.5.8",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
